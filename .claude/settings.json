{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(bash orchestrator/e2e-gate.sh)",
      "Bash(bash orchestrator/e2e-gate.sh:*)",
      "Bash(cat:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(ls:*)",
      "Bash(npm run build:*)",
      "Bash(npm run cf-typegen:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm test:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(rg:*)",
      "Edit(./src/**)",
      "Edit(./tests/**)",
      "Read(**)",
      "Write(./src/**)",
      "Write(./tests/**)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(pip install:*)",
      "Bash(pnpm add:*)",
      "Bash(uv add:*)",
      "Edit(./package.json)",
      "Edit(./**/package.json)",
      "Edit(./Dockerfile)",
      "Edit(./docker-compose.yml)",
      "Edit(./.github/**)",
      "Edit(./infra/**)",
      "Edit(./terraform/**)",
      "Edit(./**/migrations/**)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/id_rsa*)",
      "Read(./**/*.pem)",
      "Read(./**/*.p12)",
      "Read(./**/credentials.json)",
      "Read(./**/service-account*.json)",
      "Read(./.git/config)",
      "Read(./.orchestrator/state/*.diff)",
      "Read(./.orchestrator/logs/*)",
      "Edit(./.git/**)",
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git remote set-url:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout main:*)",
      "Bash(git switch main:*)",
      "Bash(git rebase main:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git filter-branch:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(chown:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(nc:*)",
      "Bash(npm publish:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh release create:*)",
      "Bash(gh workflow run:*)",
      "Bash(git tag -d:*)",
      "Bash(docker:*)",
      "Bash(kubectl:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(aws:*)",
      "Bash(gcloud:*)",
      "Bash(az:*)",
      "Bash(eval:*)",
      "Bash(bash -c:*)",
      "Bash(sh -c:*)"
    ]
  },
  "disableAllHooks": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-push.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-publish.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/notify-escalade.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "cleanupPeriodDays": 30,
  "includeCoAuthoredBy": false,
  "_commentaire_e2e_agent": "2026-09-27 (decision de l exploitant, T-004) : l agent peut lancer le controle E2E du projet (orchestrator/e2e-gate.sh : D1 locale neuve, .dev.vars factice, jamais la production) pour voir ses tests rouges puis verts. Le script est un fichier critique : l agent ne peut pas le modifier."
}
