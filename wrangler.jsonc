{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "izigsm",
  "compatibility_date": "2026-04-13",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],

  // ── Cloudflare D1 (SQLite edge) ──────────────────────────────────────────
  // Base créée le 2026-07-08 sur Contact@soteli.fr's Account
  "d1_databases": [
    {
      "binding":       "DB",
      "database_name": "izigsm-production",
      "database_id":   "1e5c6e26-6b55-4b00-bf83-72ba26b6b112"
    }
  ],

  // ── R2 Storage (photos tickets) ──────────────────────────────────────────
  // Sprint 2.36 — MOD-01 : stockage binaire photos avant/après réparation.
  // R2 activé le 2026-07-09 — migration Cloudflare (izigsm-photos)
  "r2_buckets": [
    {
      "binding":     "PHOTOS",
      "bucket_name": "izigsm-photos"
    }
  ],

  // ── Variables non-secrètes ────────────────────────────────────────────────
  // FRONTEND_URL absente jusqu'ici → tous les liens dans les emails (suivi,
  // devis...) retombaient sur le fallback 'http://localhost:3000' en prod
  // (bug découvert le 2026-07-10, lien "Suivre ma réparation" cassé pour le client).
  // MOBILAX_API_BASE : adresse de l'API Mobilax (ticket 03, chantier integration-mobilax).
  // PRÉPRODUCTION pour l'instant — seule une clé de préproduction existe (décision du
  // 2026-09-11). Passage en production : `https://apiv2.mobilax.fr/v1.0/external`, en même
  // temps que la saisie d'une clé de production dans la fiche du fournisseur Mobilax.
  "vars": {
    "FRONTEND_URL": "https://repairdesk.fr",
    "MOBILAX_API_BASE": "https://apiv2.mobilax.pro/v1.0/external"
  }

  // ── Secrets ──────────────────────────────────────────────────────────────
  // Configurer via : npx wrangler pages secret put JWT_SECRET --project-name izigsm
  //                  npx wrangler pages secret put RESEND_API_KEY --project-name izigsm
  //                  npx wrangler pages secret put FOURNISSEUR_CRYPTO_KEY --project-name izigsm
  // FOURNISSEUR_CRYPTO_KEY : clé AES-256 en hex (64 caractères), ex. génération locale
  // avec `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
  // Chiffre les clés API des fournisseurs (ex. Mobilax) au repos — src/lib/chiffrement.ts,
  // ticket 01 du chantier `integration-mobilax`. ⊥ à confondre avec une clé par boutique :
  // c'est la clé d'enveloppe, globale, qui déchiffre une valeur propre à chaque ligne
  // `fournisseurs`.
}
